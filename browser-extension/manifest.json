{
  "manifest_version": 3,
  "name": "觅同 · 当前页面采集",
  "version": "1.0.0",
  "description": "在你已打开的 Temu 页面上手动采集公开商品资料，导出后在觅同核对入库。",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {"default_popup": "popup.html", "default_title": "采集当前商品页面"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
